# .env.example — Growth Agent 10x Free
# Kopieer naar .env en vul in. NOOIT echte waarden committen naar git.
# Alle diensten hieronder hebben een gratis tier — nergens voor betalen.

# Supabase project-URL. Gratis te vinden op: https://supabase.com/dashboard
# (project aanmaken → Project Settings → API → Project URL)
SUPABASE_URL=

# Supabase service_role key (NIET de anon key — server-side nodig).
# Gratis te vinden op: https://supabase.com/dashboard → Project Settings → API
SUPABASE_SERVICE_KEY=

# Groq API key — gratis tier: 14.400 requests/dag.
# Gratis aanmaken op: https://console.groq.com → API Keys
GROQ_API_KEY=

# Google Gemini API key — gratis tier: 1.500 requests/dag.
# Gratis aanmaken op: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Cohere API key — gratis tier: 1.000 requests/dag (trial).
# Gratis aanmaken op: https://dashboard.cohere.com → API Keys
COHERE_API_KEY=

# Telegram bot token van @BotFather — volledig gratis.
# Aanmaken: chat met @BotFather in Telegram → /newbot → token kopiëren
TELEGRAM_BOT_TOKEN=

# Telegram chat-ID van de beheerder (ontvangt alerts en goedkeuringen) — gratis.
# Te vinden door @userinfobot een bericht te sturen in Telegram
TELEGRAM_ADMIN_CHAT_ID=

# Fernet-encryptiesleutel (32-byte, URL-safe base64) voor YouTube OAuth-tokens.
# Gratis genereren met de meegeleverde helper:
#   python3 scripts/crypto_helper.py --generate-key
ENCRYPTION_KEY=

# Publieke URL van het Streamlit-dashboard (Community Cloud, gratis).
# Bijv. https://jouw-app.streamlit.app — in te stellen na deploy
DASHBOARD_URL=

# Wachtwoord voor het Streamlit-dashboard (kies zelf een sterk wachtwoord).
DASHBOARD_PASSWORD=

# Map met YouTube OAuth client_secrets.json bestanden per kanaal (één per kanaal).
# Gratis GCP-projecten aanmaken op: https://console.cloud.google.com
# (YouTube Data API v3 inschakelen → OAuth client ID downloaden als JSON)
YOUTUBE_CLIENT_SECRETS_DIR=

# Shared secret waarmee GitHub Actions de Colab-notebook trigger aanzet — gratis.
# Kies zelf een lange willekeurige string; moet overeenkomen met het Colab-secret.
COLAB_TRIGGER_TOKEN=
